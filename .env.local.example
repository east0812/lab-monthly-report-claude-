# ─────────────────────────────────────────────────────────────
# 연구소 월차보고 관리 사이트 환경변수 예시
# 이 파일을 .env.local 로 복사한 뒤 값을 채워 주세요. (.env.local 은 공유·커밋 금지)
# 모든 값은 서버에서만 사용합니다. 브라우저로 전달되는 값은 없습니다.
# ─────────────────────────────────────────────────────────────

# Supabase 프로젝트 URL (Project Settings → API)
SUPABASE_URL=

# 공개 키: anon(또는 publishable) 키
SUPABASE_ANON_KEY=

# 서비스 키: service_role(또는 secret) 키. 직원 계정 생성·비밀번호 재설정에만 사용. 절대 외부 노출 금지
SUPABASE_SERVICE_ROLE_KEY=

# PostgreSQL 연결 문자열 (Project Settings → Database → Connection string)
# IPv4 사내망에서는 "Session pooler" 주소를 사용하세요. 비밀번호의 특수문자는 URL 인코딩이 필요합니다.
DATABASE_URL=

# 직원이 접속하는 주소 (예: http://192.168.0.10:3000). 비밀번호 재설정 메일의 콜백 주소에 사용
APP_BASE_URL=

# 첨부파일 저장 폴더 (서버 PC 기준 경로). 비워 두면 ./data/attachments
ATTACHMENT_DIR=

# 직원 이메일 비밀번호 재설정: Custom SMTP 와 Redirect URL 을 설정한 뒤 true 로 변경
PASSWORD_RESET_EMAIL_ENABLED=false

# HTTPS 로 서비스할 때만 true (쿠키에 Secure 속성 부여)
COOKIE_SECURE=false

# 검증용 가상 데이터 스크립트 허용 여부. 운영 환경에서는 반드시 false
ALLOW_DEMO_SEED=false
